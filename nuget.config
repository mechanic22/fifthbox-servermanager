<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- FifthBox first-party packages. Credentials are machine/CI-provided (a GitHub PAT with
         read:packages), keyed to this source name — never committed. -->
    <add key="GitHub" value="https://nuget.pkg.github.com/5thBox/index.json" />
  </packageSources>
</configuration>
