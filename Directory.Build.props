<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    FifthBox library references. Default: consume the published NuGet packages (the honest consumer
    story). "Local" mode swaps to cross-repo ProjectReferences for co-development — compile the
    sibling library source directly, no repack/repush churn.

    Flip globally with -p:UseLocalFifthBox=true (or the env var), or per library with
    UseLocalIdentity / UseLocalMaterial. The sibling .csproj paths are referenced directly and are
    NOT added to the solution.

    Default is published packages (the honest consumer story): Identity 1.2.1 (core + AspNetCore +
    EntityFrameworkCore + BCrypt + Blazor) and Material 1.0.28. Flip to local for co-development with
    -p:UseLocalFifthBox=true (or per library with UseLocalIdentity / UseLocalMaterial).
  -->
  <PropertyGroup>
    <UseLocalFifthBox Condition="'$(UseLocalFifthBox)' == ''">false</UseLocalFifthBox>
    <UseLocalIdentity Condition="'$(UseLocalIdentity)' == ''">$(UseLocalFifthBox)</UseLocalIdentity>
    <UseLocalMaterial Condition="'$(UseLocalMaterial)' == ''">true</UseLocalMaterial>
    <UseLocalEncryption Condition="'$(UseLocalEncryption)' == ''">false</UseLocalEncryption>

    <FifthBoxIdentityRepo>$(MSBuildThisFileDirectory)../fifthbox-identity</FifthBoxIdentityRepo>
    <FifthBoxMaterialRepo>$(MSBuildThisFileDirectory)../fifthbox-materialcomponents</FifthBoxMaterialRepo>
    <FifthBoxEncryptionRepo>$(MSBuildThisFileDirectory)../fifthbox-encryption-aes</FifthBoxEncryptionRepo>

    <FifthBoxIdentityVersion>1.2.3</FifthBoxIdentityVersion>
    <FifthBoxMaterialVersion>1.0.32</FifthBoxMaterialVersion>
    <FifthBoxEncryptionVersion>0.1.0</FifthBoxEncryptionVersion>
  </PropertyGroup>
</Project>
