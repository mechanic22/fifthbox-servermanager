<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>FifthBox.ServerManager.Agent</RootNamespace>
    <AssemblyName>fbsm-agent</AssemblyName>
    <!-- Ships as one file the operator copies to a machine; the .pdb would just be noise beside it. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <!-- Runtime state the agent writes beside itself. The SDK's json globbing otherwise sweeps a dev
       machine's enrolled credential into the published package and ships it to every target. -->
  <ItemGroup>
    <Content Remove="agent-credentials.json" />
    <Content Remove="agent-state.json" />
    <None Remove="agent-credentials.json" />
    <None Remove="agent-state.json" />
  </ItemGroup>

</Project>
