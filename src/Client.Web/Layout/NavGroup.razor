<div class="mt-4 first:mt-0">
    <div class="px-3 text-[11px] uppercase tracking-wide opacity-50">@Label</div>
    <div class="mt-1 flex flex-col gap-0.5">@ChildContent</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
