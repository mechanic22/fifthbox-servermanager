@* The nav itself, so the sidebar and the small-screen drawer show the same thing rather than two
   copies that drift. Admin areas are gated by the same AdminOnly policy the Host enforces. *@

<nav class="flex-1 px-2 py-2 overflow-y-auto" @onclick="OnNavigate">
    <NavGroup Label="Overview">
        <NavItem Href="" Match="NavLinkMatch.All">Home</NavItem>
    </NavGroup>

    @* NavGroup renders its label unconditionally, so a group whose every item is admin-only has to be
       gated as a whole or a stray header is left behind. *@
    <AuthorizeView Policy="@AuthPolicies.AdminOnly" Context="a1">
        <NavGroup Label="Cluster">
            <NavItem Href="cluster">Cluster</NavItem>
            <NavItem Href="system">System</NavItem>
        </NavGroup>
    </AuthorizeView>

    @* The one group a non-admin can reach — what they see inside it is decided per application by
       their granted level. *@
    <NavGroup Label="Applications">
        <NavItem Href="workloads">All applications</NavItem>
        <AuthorizeView Policy="@AuthPolicies.AdminOnly" Context="a2">
            <NavItem Href="routes">Routes</NavItem>
            <NavItem Href="hostnames">Hostnames</NavItem>
        </AuthorizeView>
    </NavGroup>

    <AuthorizeView Policy="@AuthPolicies.AdminOnly" Context="a3">
        <NavGroup Label="Settings">
            <NavItem Href="settings">Settings</NavItem>
            <NavItem Href="admin">Admin</NavItem>
        </NavGroup>
    </AuthorizeView>
</nav>

@code {
    /// Lets the drawer close itself when a link inside is taken.
    [Parameter] public EventCallback OnNavigate { get; set; }
}
