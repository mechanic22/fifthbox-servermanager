@* Route fields. Fields only — the host owns the EditForm + submit. There is no target picker: a
   workload route is opened from its workload, an external one from the Routes page. *@

<div class="flex flex-col gap-4 sm:min-w-88">
    <MaterialInput @bind-Value="Model.Hostname" For="@(() => Model.Hostname)" Label="Hostname (e.g. app.example.com)" Disabled="Busy" />
    <MaterialInput @bind-Value="Model.Path" Label="Path" Disabled="Busy" />

    @if (Model.Target == RouteTarget.External)
    {
        <MaterialSelect @bind-Value="Model.UpstreamScheme" Options="Schemes" OptionTextSelector="SchemeLabel"
                        Label="Upstream scheme"
                        Disabled="Busy" />
        <MaterialInput @bind-Value="Model.UpstreamHost" Label="Upstream host or IP (no scheme or port)" Disabled="Busy" />
    }

    <MaterialInput @bind-Value="Model.TargetPort" Label="@PortLabel()" Type="number" Disabled="Busy" />

    <MaterialSwitch @bind-Value="Model.WebSockets" Label="WebSocket support" Disabled="Busy" />

    <MaterialInput @bind-Value="Model.MaxBodySizeMb" For="@(() => Model.MaxBodySizeMb)" Type="number"
                   Label="Max request body (MB) — blank = 1 MB, 0 = unlimited" Disabled="Busy" />

    <MaterialSwitch @bind-Value="Model.BasicAuthEnabled" Label="Require basic auth" Disabled="Busy" />
    @if (Model.BasicAuthEnabled)
    {
        <div class="flex flex-col gap-4 pl-4 border-l-2" style="border-color: var(--md-sys-color-outline-variant)">
            <MaterialInput @bind-Value="Model.BasicAuthUsername" Label="Username" Disabled="Busy" />
            <MaterialInput @bind-Value="Model.BasicAuthPassword" Type="password"
                           Label="@(IsEdit ? "New password (blank = keep current)" : "Password")" Disabled="Busy" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required RouteFormModel Model { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public bool Busy { get; set; }

    private static readonly UpstreamScheme[] Schemes = [UpstreamScheme.Http, UpstreamScheme.Https];

    private static string SchemeLabel(UpstreamScheme scheme) => scheme == UpstreamScheme.Https ? "https" : "http";

    private string PortLabel() =>
        Model.Target == RouteTarget.External ? "Upstream port" : "Target port (the container's port)";
}
