@* Read-only view of a hostname's TLS state. Managing it lives on the Hostnames page — certificates cover
   a whole hostname, so acting on one from a page showing a single route or workload would reach further
   than the page appears to. *@

<a href="hostnames" class="no-underline" title="@Tooltip()">
    <MaterialChip Text="@Text()" Size="MaterialChipSize.Small" Color="@Color()" />
</a>

@code {
    [Parameter] public CertificateStatus? Status { get; set; }
    [Parameter] public DateTimeOffset? NotAfter { get; set; }

    private string Text() => Status switch
    {
        null => "HTTP",
        CertificateStatus.Valid => NotAfter is { } expiry ? $"HTTPS · {Days(expiry)}" : "HTTPS",
        CertificateStatus.Pending => "TLS pending",
        _ => "TLS failed",
    };

    private MaterialChipColor Color() => Status switch
    {
        CertificateStatus.Valid => MaterialChipColor.Primary,
        CertificateStatus.Pending => MaterialChipColor.Tertiary,
        CertificateStatus.Failed => MaterialChipColor.Error,
        _ => MaterialChipColor.Default,
    };

    private string Tooltip() => Status is null
        ? "Served over plain HTTP — manage certificates on the Hostnames page"
        : "Manage certificates on the Hostnames page";

    private static string Days(DateTimeOffset expiry)
    {
        var days = (int)Math.Floor((expiry - DateTimeOffset.UtcNow).TotalDays);
        return days < 0 ? "expired" : $"{days}d";
    }
}
