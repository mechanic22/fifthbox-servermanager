@* TODO: promote to FifthBox.MaterialComponents.Blazor *@

<div class="flex flex-col gap-2">
    @if (AllowBulk)
    {
        <MaterialSwitch Value="_bulk" ValueChanged="@((bool on) => ToggleBulk(on))" Label="Bulk edit" Disabled="Disabled" />
    }

    @if (_bulk)
    {
        @* the wrapper carries the ::deep rule into the textarea, a class on MaterialInput lands on its container *@
        <div class="mono-field mt-4">
            <MaterialInput Value="_bulkText" ValueChanged="@((string? text) => ParseBulk(text))"
                           Variant="MaterialInputVariant.Outlined" Size="MaterialSize.Small" Multiline Rows="6" Label="@BulkLabel"
                           Disabled="Disabled" />
        </div>
    }
    else
    {
        <div class="mono-field">
            @for (var i = 0; i < Items.Count; i++)
            {
                var index = i;
                <div class="flex gap-2 items-center mt-4">
                    <div class="w-1/3">
                        <MaterialInput @bind-Value="Items[index].Key" Variant="MaterialInputVariant.Outlined"
                                       Size="MaterialSize.Small" Label="@KeyPlaceholder" Disabled="Disabled" />
                    </div>
                    <span class="opacity-60">=</span>
                    <div class="flex-1">
                        <MaterialInput @bind-Value="Items[index].Value" Variant="MaterialInputVariant.Outlined"
                                       Type="@(Items[index].Secret ? "password" : "text")"
                                       Size="MaterialSize.Small"
                                       Label="@ValuePlaceholder"
                                       TrailingIcon="@(AllowSecrets ? SecretToggle(index) : null)"
                                       Disabled="Disabled" />
                    </div>

                    <MaterialIconButton OnClick="@(() => Remove(index))" Disabled="Disabled">
                        <Icon>
                            <MaterialIcon FillColor="#FF0000" Path="@MaterialIcons.Close" Size="IconSize.XS" />
                        </Icon>
                    </MaterialIconButton>
                </div>
            }
        </div>
        <div>
            <MaterialButton Text="Add" Style="MaterialButtonStyle.Text" OnClick="Add" Disabled="Disabled" />
        </div>
    }
</div>

@code {
    // the eye is the only secret hint, so the label goes on the button
    private RenderFragment SecretToggle(int index) => @<MaterialIconButton
        Size="MaterialSize.Small"
        IconPath="@(Items[index].Secret ? MaterialIcons.VisibilityOn : MaterialIcons.VisibilityOff)"
        aria-label="@(Items[index].Secret ? "Unmark as secret" : "Mark as secret")"
        title="@(Items[index].Secret ? "Unmark as secret" : "Mark as secret")"
        OnClick="@(() => SetSecret(index, !Items[index].Secret))"
        Disabled="Disabled" />;

    [Parameter] public List<KeyValueItem> Items { get; set; } = [];
    [Parameter] public string KeyPlaceholder { get; set; } = "key";
    [Parameter] public string ValuePlaceholder { get; set; } = "value";
    [Parameter] public string BulkLabel { get; set; } = "One KEY=VALUE per line";
    [Parameter] public bool AllowBulk { get; set; } = true;
    [Parameter] public bool AllowSecrets { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _bulk;
    private string _bulkText = string.Empty;

    private void ToggleBulk(bool on)
    {
        if (on)
        {
            _bulkText = string.Join('\n', Items.Select(x => $"{x.Key}={x.Value}"));
        }

        _bulk = on;
    }

    // mutates Items in place so the parent sees it
    private void ParseBulk(string? text)
    {
        _bulkText = text ?? string.Empty;

        // carry secret flags over by key or a secret comes back plain and saves unencrypted
        var secrets = Items.Where(x => x.Secret).Select(x => x.Key).ToHashSet();

        Items.Clear();
        foreach (var line in _bulkText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var parts = line.Split('=', 2);
            if (parts[0].Length > 0)
            {
                var key = parts[0].Trim();
                Items.Add(new KeyValueItem
                {
                    Key = key,
                    Value = parts.Length > 1 ? parts[1].Trim() : string.Empty,
                    Secret = secrets.Contains(key),
                });
            }
        }
    }

    private void SetSecret(int index, bool on) => Items[index].Secret = on;

    private void Add() => Items.Add(new KeyValueItem());

    private void Remove(int index) => Items.RemoveAt(index);
}
