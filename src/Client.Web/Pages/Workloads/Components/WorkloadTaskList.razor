@* several rows per replica is normal, dead attempts open up when swarm is short a replica *@

<MaterialTable Variant="MaterialTableVariant.Dense">
    <thead>
        <tr>
            <th>Replica</th>
            <th>Node</th>
            <th>State</th>
            <th>Usage</th>
            <th>When</th>
            <th>Detail</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Displayed)
        {
            <tr>
                <td data-label="Replica">@t.Slot</td>
                <td data-label="Node" class="text-sm">@NodeText(t)</td>
                <td data-label="State">
                    <StatusChip Text="@t.State.ToString()" Tone="@StatusTones.For(t)" />
                    @if (t.DesiredState == WorkloadTaskState.Running)
                    {
                        <MaterialChip Text="current" Size="MaterialChipSize.Small" />
                    }
                </td>
                <td data-label="Usage" class="text-sm whitespace-nowrap">@UsageFor(t)</td>
                <td data-label="When" class="text-xs opacity-70">@WhenText(t)</td>
                <td data-label="Detail" class="text-xs @(t.Error is null ? "opacity-60" : "")"
                    style="@(t.Error is null ? "" : "color: var(--md-sys-color-error)")">
                    @(t.Error ?? t.Message ?? "—")
                </td>
            </tr>
        }
    </tbody>
</MaterialTable>

@if (_earlier.Count > 0 && !_unhealthy)
{
    <MaterialButton Text="@ToggleText()" Style="MaterialButtonStyle.Text" Size="MaterialSize.Small" class="mt-2"
                    OnClick="@(() => _showEarlier = !_showEarlier)" />
}

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<WorkloadTask> Tasks { get; set; }

    /// null for non-admins, the short id is enough to tell replicas apart
    [Parameter] public IReadOnlyList<NodeResponse>? Nodes { get; set; }

    /// null means fbsm-stats has nothing recent for that task
    [Parameter] public Func<string, ContainerStatsEntry?>? StatsFor { get; set; }

    /// cores
    [Parameter] public double? CpuLimit { get; set; }

    private bool _showEarlier;
    private IReadOnlyList<WorkloadTask> _live = [];
    private IReadOnlyList<WorkloadTask> _earlier = [];
    private bool _unhealthy;

    private IReadOnlyList<WorkloadTask> Displayed => _showEarlier || _unhealthy ? Tasks : _live;

    protected override void OnParametersSet()
    {
        var current = Tasks.Where(t => t.DesiredState == WorkloadTaskState.Running).ToList();

        // nothing desired-running, show the last attempt rather than an empty table
        _live = current.Count > 0 ? current : [.. Tasks.Take(1)];
        _earlier = [.. Tasks.Where(t => !_live.Contains(t))];
        _unhealthy = current.Any(t => t.State != WorkloadTaskState.Running);
    }

    private string ToggleText() => _showEarlier
        ? "Hide earlier attempts"
        : $"Show {_earlier.Count} earlier attempt{(_earlier.Count == 1 ? "" : "s")}";

    private string NodeText(WorkloadTask t)
    {
        if (t.NodeId is null)
        {
            return "unplaced";
        }

        return Nodes?.FirstOrDefault(n => n.Id == t.NodeId)?.Hostname ?? t.NodeId[..Math.Min(12, t.NodeId.Length)];
    }

    private string UsageFor(WorkloadTask t) =>
        t.State == WorkloadTaskState.Running && StatsFor?.Invoke(t.Id) is { } stats ? UsageText.Replica(stats, CpuLimit) : "—";

    private static string WhenText(WorkloadTask t) =>
        t.Since is { } since ? since.LocalDateTime.ToString("g") : "—";

    // desired Running but not running is the failure, finished tasks are just history
}
