@if (HasDetails)
{
    <MaterialCard Variant="MaterialCardVariant.Outlined" class="p-4">
        <h2 class="text-xs font-medium opacity-60 uppercase tracking-wide mb-3">Details</h2>
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2 flex-wrap">
                @if (Workload.Kind == WorkloadKind.Native && Status is { Pid: { } pid })
                {
                    <span class="text-sm opacity-70">PID @pid</span>
                    @if (Status.StartedAt is { } since)
                    {
                        <span class="text-sm opacity-70">up @UptimeText(since)</span>
                    }
                    @if (Status.Adopted)
                    {
                        <MaterialChip Text="adopted" Size="MaterialChipSize.Small" />
                    }
                }

                @if (Status?.InstalledVersion is { Length: > 0 } version)
                {
                    <span class="text-sm opacity-70">@version</span>
                }
                @* null = nothing to probe (udp-only, say), so say nothing *@
                @if (Status?.Reachable is false)
                {
                    <StatusChip Text="not answering" Tone="StatusTone.Bad" />
                }
                @if (Status?.MemoryBytes is { } memory)
                {
                    <span class="text-sm opacity-70">@Mb(memory)</span>
                }
                @if (Status?.CpuPercent is { } cpu)
                {
                    <span class="text-sm opacity-70">@cpu.ToString("0.#")% cpu</span>
                }
                @if (Status is { RestartCount: > 0 })
                {
                    <span class="text-sm opacity-70">@Status.RestartCount restart(s)</span>
                }
                @if (Status?.ExitCode is { } exitCode)
                {
                    <span class="text-sm opacity-70">last exit @exitCode</span>
                }
            </div>

            @if (Status?.UpdateState is "updating" or "rollback_completed" or "rollback_started" or "paused")
            {
                <div class="flex items-center gap-2 flex-wrap">
                    <StatusChip Text="@RolloutText(Status.UpdateState)" Tone="@RolloutTone(Status.UpdateState)" />
                    <span class="text-xs opacity-60">@Status.UpdateMessage</span>
                </div>
            }

            @if (Status?.RunningImage is { Length: > 0 } image)
            {
                <span class="text-xs opacity-60 font-mono" title="@image">Running @ImageText(image)</span>
            }

            @* not running, it's the banner at the top of the page *@
            @if (Status is { State: WorkloadState.Running, LastError: { Length: > 0 } error })
            {
                <span class="text-sm" style="color: var(--md-sys-color-error)">@error</span>
            }

            @if (!string.IsNullOrWhiteSpace(Status?.Detail))
            {
                <span class="text-xs opacity-60">@Status!.Detail</span>
            }
        </div>
    </MaterialCard>
}

@code {
    [Parameter, EditorRequired] public required WorkloadResponse Workload { get; set; }
    [Parameter] public WorkloadRuntimeStatus? Status { get; set; }

    private bool HasDetails => Status is { } s && (
        (Workload.Kind == WorkloadKind.Native && s.Pid is not null)
        || s.InstalledVersion is { Length: > 0 }
        || s.Reachable is false
        || s.MemoryBytes is not null
        || s.CpuPercent is not null
        || s.RestartCount > 0
        || s.ExitCode is not null
        || s.UpdateState is "updating" or "rollback_completed" or "rollback_started" or "paused"
        || s.RunningImage is { Length: > 0 }
        || s is { State: WorkloadState.Running, LastError.Length: > 0 }
        || !string.IsNullOrWhiteSpace(s.Detail));

    private static string RolloutText(string? updateState) => updateState switch
    {
        "updating" => "Deploying",
        "rollback_completed" => "Rolled back",
        "rollback_started" => "Rolling back",
        _ => "Paused",
    };

    private static StatusTone RolloutTone(string? updateState) =>
        updateState == "updating" ? StatusTone.Warn : StatusTone.Bad;

    /// the digest shows whether a :latest redeploy actually picked up the new build
    private static string ImageText(string image)
    {
        var parts = image.Split('@', 2);
        return parts.Length == 2 && parts[1].Length > 19
            ? $"{parts[0]} ({parts[1][7..19]})"
            : image;
    }

    private static string UptimeText(DateTimeOffset since)
    {
        var span = DateTimeOffset.UtcNow - since;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalDays >= 1 ? $"{(int)span.TotalDays}d {span.Hours}h"
            : span.TotalHours >= 1 ? $"{(int)span.TotalHours}h {span.Minutes}m"
            : span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes}m"
            : $"{(int)span.TotalSeconds}s";
    }

    private static string Mb(long bytes) => $"{bytes / 1024d / 1024:0.#} MB";
}
