<MaterialCard Variant="MaterialCardVariant.Outlined" class="p-4 flex flex-col gap-4">
    <h2 class="text-xs font-medium opacity-60 uppercase tracking-wide">Networking</h2>

    @if (AllowWebAddress)
    {
        <div class="flex flex-col gap-2">
            <MaterialSwitch Value="Model.WebApp" ValueChanged="@((bool on) => Model.WebApp = on)"
                            Label="Give it a web address" Disabled="Busy || !HasRootDomain" />
            @if (Model.WebApp)
            {
                <div class="@DetailCss">
                    <span class="font-mono text-sm">@AutoHostname()</span>
                    <div class="w-64">
                        <MaterialInput @bind-Value="Model.HttpPort" For="@(() => Model.HttpPort)"
                                       Variant="MaterialInputVariant.Outlined" Size="MaterialSize.Small" Type="number"
                                       Label="Listens on port" Disabled="Busy" />
                    </div>
                </div>
            }
        </div>
    }

    <div class="flex flex-col gap-2">
        <span class="text-sm">Published ports</span>
        <PortListEditor Ports="Model.Ports" Disabled="Busy" />
        @if (Model.HasOutOfRangePortRow())
        {
            <span class="text-xs" style="color: var(--md-sys-color-error)">A published port must be between
                1 and 65535.</span>
        }
    </div>
</MaterialCard>

@code {
    [Parameter, EditorRequired] public required WorkloadFormModel Model { get; set; }
    [Parameter] public bool Busy { get; set; }

    [Parameter] public string? RootDomain { get; set; }

    /// create only, after that the address is just a route
    [Parameter] public bool AllowWebAddress { get; set; }

    private const string DetailCss = "flex flex-col gap-2 pl-12";

    private bool HasRootDomain => !string.IsNullOrWhiteSpace(RootDomain);

    private string AutoHostname() =>
        $"{(string.IsNullOrWhiteSpace(Model.Name) ? "<name>" : Slugify(Model.Name))}.{RootDomain}";

    /// mirrors the server's slug rule, only for the preview
    private static string Slugify(string value)
    {
        var separated = new string([.. value.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-')]);
        return string.Join('-', separated.Split('-', StringSplitOptions.RemoveEmptyEntries));
    }
}
