{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Data Source=fifth-box-server-manager.db"
  },
  "Acme": {
    "Directory": "staging"
  },
  "Identity": {
    "RegistrationPolicy": "AdminOnly",
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Duration": "00:15:00"
    },
    "Jwt": {
      "Issuer": "FifthBox.ServerManager",
      "Audience": "FifthBox.ServerManager",
      "AccessTokenMinutes": 60,
      "RefreshTokenDays": 30
    }
  }
}
